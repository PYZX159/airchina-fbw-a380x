* text=auto

# Preserve third-party SVG originals byte-for-byte.
resources/airchina/*.svg -text -whitespace
*.py text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.cfg text eol=crlf
*.svg text eol=lf
*.png binary
*.PNG binary
*.jpg binary
*.jpeg binary
*.webp binary
*.dds binary
*.DDS binary
*.xcf binary
*.XCF binary
*.zip binary
*.npz binary
*.blend binary

# Preserve every byte and indexed file size of the user-validated installable.
package/** -text -whitespace
deliverables/** -text -whitespace
